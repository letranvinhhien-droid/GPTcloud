{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "meridian-lms",
  "main": "workers/index.js",
  "compatibility_date": "2025-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api", "/api/*"],
  },
  "vars": {
    "NODE_ENV": "production",
    "LMS_DEMO": "false",
    "LMS_SEED": "false",
    "LMS_COOKIE_SECURE": "true",
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "LMS_WORKSPACE",
        "class_name": "MeridianWorkspace",
      },
    ],
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["MeridianWorkspace"],
    },
  ],
}
